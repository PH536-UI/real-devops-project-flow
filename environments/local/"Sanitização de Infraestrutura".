#!/bin/bash

echo "--- Iniciando limpeza da estrutura Terraform ---"

# 1. Remove o bloco provider "aws" do main.tf para evitar conflito
# Usamos o sed para deletar o bloco entre provider "aws" e a chave de fechamento
sed -i '/provider "aws" {/,/}/d' environments/local/main.tf

# 2. Garante que o provider.tf está íntegro e único
# (Certifique-se de que o seu provider.tf já está correto conforme orientamos)

# 3. Limpa caracteres invisíveis de todos os .tf na pasta
find environments/local/ -name "*.tf" -exec sed -i 's/\r$//' {} \;

echo "Limpeza concluída. Validando configuração..."

# 4. Valida a infraestrutura
cd environments/local/ && terraform validate && cd ../..

echo "--- Scan de segurança final ---"
./seguranca.sh
